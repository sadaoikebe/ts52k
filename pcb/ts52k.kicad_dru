(version 1)

# TC52 wireless: tracks leaving the MDBT50Q between its 0.4 mm pads (0.1 mm necks on the inner-row pads).
(rule "Module pad escape"
  (condition "A.Type == 'Track' && B.Type == 'Pad' && B.memberOfFootprint('U5')")
  (constraint clearance (min 0.14mm)))

# TC52 wireless: +3V3 / +3V3M vias that sit in their own bundle lane (neighbour lanes 0.525 mm away).
(rule "Lane vias"
  (condition "A.Type == 'Via' && (A.NetName == '+3V3M' || A.NetName == '+3V3') && B.Type == 'Track' && (B.NetName == 'S??' || B.NetName == 'INH?' || B.NetName == 'ENC_*' || B.NetName == '+3V3')")
  (constraint clearance (min 0.14mm)))

# TC52 (design-spec section 5): high-impedance nets keep 2.0 mm from everything that is not matrix or ground.
# Checked between tracks and vias; pad adjacency at the MUX pins and the AFE parts is reviewed by hand.
(rule "HIZ to other nets 2.0 mm"
  (condition "(A.Type == 'Track' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Via') && (A.NetName == 'COL*' || A.NetName == 'SENSE') && B.NetName != 'COL*' && B.NetName != 'ROW*' && B.NetName != 'SENSE' && B.NetName != 'GND' && B.NetName != 'AMP_IN' && !(A.intersectsArea('HIZ_LOCAL') && B.intersectsArea('HIZ_LOCAL'))")
  (constraint clearance (min 2.0mm)))

# Column to column / column to SENSE: 1.5 mm centre to centre for 0.2 mm tracks.
(rule "HIZ to HIZ 1.3 mm"
  (condition "(A.Type == 'Track' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Via') && (A.NetName == 'COL*' || A.NetName == 'SENSE') && (B.NetName == 'COL*' || B.NetName == 'SENSE') && A.Net != B.Net && !(A.intersectsArea('HIZ_LOCAL') && B.intersectsArea('HIZ_LOCAL'))")
  (constraint clearance (min 1.3mm)))

# TC2030-IDC-NL datasheet rev. B: 0.020 inch to other exposed-side signals.
(rule "Tag-Connect contact clearance"
 (layer "B.Cu")
 (condition "(A.Type == 'Pad' && A.memberOfFootprint('J2') && B.Type != 'Pad') || (B.Type == 'Pad' && B.memberOfFootprint('J2') && A.Type != 'Pad')")
 (constraint clearance (min 0.508mm)))

# TC52 bundle (static select lines, encoder, MUX supply): 0.15 mm track / 0.15 mm gap (design-spec section 1).
(rule "Bundle 0.15 mm clearance"
  (condition "A.Type == 'Track' && B.Type == 'Track' && (A.NetName == 'S??' || A.NetName == 'INH?' || A.NetName == 'ENC_*' || A.NetName == 'ADC' || A.NetName == 'ROW?_DRV' || A.NetName == '+3V3M' || A.NetName == '+3V3' || A.NetName == 'MCU_VBUS') && (B.NetName == 'S??' || B.NetName == 'INH?' || B.NetName == 'ENC_*' || B.NetName == 'ADC' || B.NetName == 'ROW?_DRV' || B.NetName == '+3V3M' || B.NetName == '+3V3' || B.NetName == 'MCU_VBUS')")
  (constraint clearance (min 0.15mm)))

# Encoder pull-ups next to SW2: R15 straddles the ENC_B track (0402 pad gap 0.48 mm).
(rule "Encoder pull-up straddle"
  (condition "(A.memberOfFootprint('R15') || A.memberOfFootprint('R16')) && B.Type == 'Track' && B.NetName == 'ENC_*'")
  (constraint clearance (min 0.15mm)))

# TC52 wireless: USB pair (full speed), 0.2 mm tracks 0.15 mm apart.
(rule "USB pair"
  (condition "A.NetName == 'D+' && B.NetName == 'D-'")
  (constraint clearance (min 0.15mm)))
