(version 1)

# Matrix tracks and vias retain 0.20 mm clearance.
(rule "Matrix routing 0.20 mm clearance"
  (condition "((A.Type == 'Track' || A.Type == 'Via') && (A.NetName == 'row*' || A.NetName == 'col*')) || ((B.Type == 'Track' || B.Type == 'Via') && (B.NetName == 'row*' || B.NetName == 'col*'))")
  (constraint clearance (min 0.20mm)))

# TC2030-IDC-NL datasheet rev. B: 0.020 inch to other exposed-side signals.
(rule "Tag-Connect contact clearance"
 (layer "B.Cu")
 (condition "(A.Type == 'Pad' && A.memberOfFootprint('J2') && B.Type != 'Pad') || (B.Type == 'Pad' && B.memberOfFootprint('J2') && A.Type != 'Pad')")
 (constraint clearance (min 0.508mm)))
