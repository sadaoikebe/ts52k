+    def test_windows_uses_python_next_to_configured_cli(self, tmp_path, monkeypatch):
+        bin_dir = tmp_path / "KiCad" / "10.0" / "bin"
+        bin_dir.mkdir(parents=True)
+        python_path = bin_dir / "python.exe"
+        python_path.touch()
+        monkeypatch.setattr("kicad_mcp.utils.pcbnew_bridge.platform.system", lambda: "Windows")
+        monkeypatch.setenv("KICAD_CLI_PATH", str(bin_dir / "kicad-cli.exe"))
+
+        assert _get_kicad_python() == str(python_path)
+
+    def test_windows_falls_back_when_configured_python_is_missing(self, tmp_path, monkeypatch):
+        legacy_python = r"C:\Program Files\KiCad\bin\python.exe"
+        monkeypatch.setattr("kicad_mcp.utils.pcbnew_bridge.platform.system", lambda: "Windows")
+        monkeypatch.setenv("KICAD_CLI_PATH", str(tmp_path / "kicad-cli.exe"))
+        monkeypatch.setattr(
+            "kicad_mcp.utils.pcbnew_bridge.os.path.isfile",
+            lambda path: path == legacy_python,
+        )
+
+        assert _get_kicad_python() == legacy_python
+
