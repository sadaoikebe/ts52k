diff --git a/src/kicad_mcp/utils/pcbnew_bridge.py b/src/kicad_mcp/utils/pcbnew_bridge.py
index 8027196..efb4793 100644
--- a/src/kicad_mcp/utils/pcbnew_bridge.py
+++ b/src/kicad_mcp/utils/pcbnew_bridge.py
@@ -61,7 +61,14 @@ def _get_kicad_python() -> Optional[str]:
     elif system == "Linux":
         candidates = ["/usr/bin/python3"]
     elif system == "Windows":
-        candidates = [r"C:\Program Files\KiCad\bin\python.exe"]
+        # A configured CLI lives alongside KiCad's bundled Python, including
+        # in versioned Windows installs such as KiCad\10.0\bin.  Keep the
+        # legacy location as a fallback for unversioned installations.
+        cli_path = os.environ.get("KICAD_CLI_PATH")
+        candidates = []
+        if cli_path:
+            candidates.append(os.path.join(os.path.dirname(cli_path), "python.exe"))
+        candidates.append(r"C:\Program Files\KiCad\bin\python.exe")
     else:
         candidates = []
 
@@ -213,7 +220,9 @@ def run_pcbnew_script(
         )
 
     # Write script to a temp file
-    with tempfile.NamedTemporaryFile(mode="w", suffix=".py", delete=False) as f:
+    with tempfile.NamedTemporaryFile(
+        mode="w", suffix=".py", delete=False, encoding="utf-8"
+    ) as f:
         f.write(script)
         script_path = f.name
 
