native USB Type-C connector assemblies based on your specific mounting or packaging requirements."},{"question":"Is This USB Type-C Receptacle Fully Compatible With Standard 24-Pin USB-C Cables?","answer":"Yes, it is fully compatible. While this connector has a 16-pin layout physically soldered to the board (optimizing space and cost for power and USB 2.0 data applications), it interfaces seamlessly with standard 24-pin USB Type-C cables."}],"pdfUrl":"https://datasheet.lcsc.com/datasheet/pdf/9e56b777c022540fcce7c7f67825f55e.pdf?productCode=C165948","authenticationList":null,"isRohsCert":null,"rohsCertType":null,"rohsCertList":null,"productDescEn":"USB-C (USB TYPE-C) Receptacle Connector 16 Position Surface Mount","productIntroEn":"USB-C (USB TYPE-C) Receptacle Connector 16 Position Surface Mount","paramVOList":[{"paramCode":"param_13450","paramName":"协议标准","paramNameEn":"Protocol Standard","paramValue":"-","paramValueEn":"-","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":8},{"paramCode":"param_13453_n","paramName":"端口数量","paramNameEn":"Number of Ports","paramValue":"1","paramValueEn":"1","paramValueEnForSearch":1.0,"isMain":true,"sortNumber":1,"sort":43},{"paramCode":"param_13452","paramName":"触点数量","paramNameEn":"Number of Contacts","paramValue":"16P","paramValueEn":"16P","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":221},{"paramCode":"param_26713","paramName":"连接器类型","paramNameEn":"Connector Type","paramValue":"Type-C","paramValueEn":"Type-C","paramValueEnForSearch":-1.0,"isMain":false,"sortNumber":1,"sort":2},{"paramCode":"param_26718_n","paramName":"额定电压","paramNameEn":"Voltage Rating","paramValue":"20V","paramValueEn":"20V","paramValueEnForSearch":20.0,"isMain":false,"sortNumber":1,"sort":44},{"paramCode":"param_13771_s","paramName":"工作温度","paramNameEn":"Operating Temperature","paramValue":"-30℃~+80℃","paramValueEn":"-30℃~+80℃","paramValueEnForSearch":null,"isMain":true,"sortNumber":1,"sort":12},{"paramCode":"param_26696_n",