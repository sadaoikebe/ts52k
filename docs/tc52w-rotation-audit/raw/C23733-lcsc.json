lating. Samsung states that its MLCC products comply with RoHS and REACH environmental requirements."},{"question":"What packaging and assembly information applies to the CL05A475MP5NRNC?","answer":"The \"C\" packaging code indicates 7-inch cardboard tape reel packaging. The capacitor is designed for standard surface-mount (SMT) reflow soldering processes."}],"pdfUrl":"https://datasheet.lcsc.com/datasheet/pdf/02336ea48ea44ca18c72517dd3cb7b47.pdf?productCode=C23733","authenticationList":["ROHS3 认证"],"isRohsCert":true,"rohsCertType":"ROHS3","rohsCertList":[{"fileCode":"wj1864931","fileName":" 贴片电容(MLCC)_ROHS认证_SAMSUNG(三星).zip","url":"https://datasheet.lcsc.com/certification/rohs/fe72c154ab3703f908ae5b1ac157c1ec.zip"},{"fileCode":"wj1624669","fileName":"ROHS认证_贴片电容原材料_SAMSUNG(三星).zip","url":"https://datasheet.lcsc.com/certification/rohs/329ecc8904689d9af5b272ec0ed8e00a.zip"},{"fileCode":"wj1750838","fileName":"全量通用_ROHS认证_SAMSUNG(三星半导体).pdf","url":"https://datasheet.lcsc.com/certification/rohs/fe7ad62d96832adf9770d718059cff38.pdf"},{"fileCode":"wj1478399","fileName":"MLCCCL系列_ROHS认证(英文版)_SAMSUNG(三星).pdf","url":"https://datasheet.lcsc.com/certification/rohs/5b97a5d84519001adb216d4c9e6919ce.pdf"}],"productDescEn":"4.7uF ±20% 10V Ceramic Capacitor X5R 0402","productIntroEn":"4.7uF ±20% 10V Ceramic Capacitor X5R 0402","paramVOList":[{"paramCode":"param_10951_n","paramName":"容值","paramNameEn":"Capacitance","paramValue":"4.7uF","paramValueEn":"4.7uF","paramValueEnForSearch":4700000.0,"isMain":true,"sortNumber":1,"sort":1},{"paramCode":"param_10927","paramName":"温度系数","paramNameEn":"Temperature Coefficient","paramValue":"X5R","paramValueEn":"X5R","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":4},{"paramCode":"param_10923_s","paramName":"精度","paramNameEn":"Tolerance","paramValue":"±20%","paramValueEn":"±20%","paramValueEnForSearch":null,"isMain":true,"sortNumber":1,"sort":2},{"paramCode":"param_10924_n","paramName":"额定电压","paramNameEn":"Voltage Rating","param