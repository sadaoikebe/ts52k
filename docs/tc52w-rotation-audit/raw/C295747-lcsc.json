iceList":null,"discountRate":"1","currencyPrice":0.1172,"currencySymbol":"$","isForeignDiscount":null,"ladderLevel":null}],"productImages":["https://assets.lcsc.com/images/lcsc/900x900/20230108_JST-S2B-PH-SM4-TB-LF-SN_C295747_front.jpg","https://assets.lcsc.com/images/lcsc/900x900/20230108_JST-S2B-PH-SM4-TB-LF-SN_C295747_back.jpg","https://assets.lcsc.com/images/lcsc/900x900/20230108_JST-S2B-PH-SM4-TB-LF-SN_C295747_blank.jpg"],"edaSvgInfo":{"schSvg":"//image.easyeda.com/component_svgs/prod/c9bcd71204854866a129a5264511c0b4.svg?t=1719208803","pcbSvg":"//image.easyeda.com/component_svgs/prod/a54eec112d4e47d8b8028fdda8c2c5b8.svg?t=1719208803"},"faqs":[{"question":"What are the key technical specifications of this JST connector header?","answer":"This is a 2-position wire-to-board connector header manufactured by JST (MPN: S2B-PH-SM4-TB(LF)(SN)). It belongs to the standard PH Series, featuring a 2mm pitch, a 1x2P single-row pin structure, and a Surface Mount, Right Angle (horizontal/side entry) configuration."},{"question":"What are the maximum electrical ratings and environmental limits for this connector?","answer":"The connector is rated for a maximum voltage of 100V and a current rating of 2A. It is designed to operate reliably within a temperature range from -25℃ to +85℃, making it suitable for standard electronic signaling and power delivery configurations."},{"question":"What materials are used in the construction and flame retardancy of this component?","answer":"The housing is molded from high-performance PA (Polyamide/Nylon) plastic with a Beige color and carries a UL94V-0 flame retardancy rating. The contacts are made of a durable Copper alloy finished with high-conductivity Tin plating."},{"question":"Does this surface-mount connector include alignment or physical structural supports?","answer":"Yes, the layout features a Supplementary Auxiliary Solder Pin (solder tab/ retention clip) design. This enhances the physical mechanical bond to the PCB surface, helping prevent the connector from lifting or shearing off during cable plugging and unplugging."},{"question":"What is the packaging style and the minimum order quantity (MOQ) on LCSC?","answer":"The minimum order quantity is 5 pieces, and orders must be placed in multiples of 5. Wholesale tiered quantity discounts apply for bulk purchases, and high-volume manufacturing orders are fulfilled in standard factory packaging formats suited for automated SMT pick-and-place lines."}],"pdfUrl":"https://datasheet.lcsc.com/datasheet/pdf/2474e9261ed7c5f86b55d373e724589d.pdf?productCode=C295747","authenticationList":["ROHS3 认证"],"isRohsCert":true,"rohsCertType":"ROHS3","rohsCertList":[{"fileCode":"wj1867279","fileName":"全量通用_ROHS认证_ JST.pdf","url":"https://datasheet.lcsc.com/certification/rohs/aad51754ebc44efcf40d654eb7f73bee.pdf"},{"fileCode":"wj1854336","fileName":"全量通用_ROHS认证_JST.pdf","url":"https://datasheet.lcsc.com/certification/rohs/90f213aef52bad60122b7ef61ac46bff.pdf"},{"fileCode":"wj1795018","fileName":"全量通用_ROHS认证_JST.pdf","url":"https://datasheet.lcsc.com/certification/rohs/ad56b0c2b799cc92d2d69e00a146bf43.pdf"}],"productDescEn":"Connector Header 2 position 2mm Pitch 2A Surface Mount, Right Angle -25℃~+85℃","productIntroEn":"Connector Header 2 position 2mm Pitch 2A Surface Mount, Right Angle -25℃~+85℃","paramVOList":[{"paramCode":"param_13482","paramName":"连接器类型","paramNameEn":"Connector Type","paramValue":"卧贴","paramValueEn":"Surface Mount, Right Angle","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":2},{"paramCode":"param_13673","paramName":"参考系列","paramNameEn":"Reference Series","paramValue":"PH","paramValueEn":"PH","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":59},{"paramCode":"param_13360_n","paramName":"额定电压","paramNameEn":"Voltage Rating (Max)","paramValue":"100V","paramValueEn":"100V","paramValueEnForSearch":100.0,"isMain":true,"sortNumber":1,"sort":9},{"paramCode":"param_27359","paramName":"触头材质","paramNameEn":"Contact Mater