eatures a 1kΩ resistance value with ±1% tolerance, a 62.5mW power rating, and a 50V voltage rating. The resistor operates reliably across a wide temperature range of -55°C to +155°C with a temperature coefficient of ±100ppm/℃, making it suitable for precision applications requiring stable performance in variable environments."}],"pdfUrl":"https://datasheet.lcsc.com/datasheet/pdf/0a975aaa49b7c97f38a963127be4a823.pdf?productCode=C11702","authenticationList":["ROHS 认证"],"isRohsCert":true,"rohsCertType":"ROHS","rohsCertList":[{"fileCode":"wj1549902","fileName":"贴片电阻器_ROHS认证(中文版)_UNI-ROYAL(厚声).pdf","url":"https://datasheet.lcsc.com/certification/rohs/d87d85b9a7d7b239443f5f335485cdf9.pdf"}],"productDescEn":"1kΩ ±1% 62.5mW 0402 Thick Film Resistor","productIntroEn":"1kΩ ±1% 62.5mW 0402 Thick Film Resistor","paramVOList":[{"paramCode":"param_11205_n","paramName":"阻值","paramNameEn":"Resistance","paramValue":"1kΩ","paramValueEn":"1kΩ","paramValueEnForSearch":1000.0,"isMain":true,"sortNumber":1,"sort":7},{"paramCode":"param_10837_n","paramName":"功率","paramNameEn":"Power(Watts)","paramValue":"62.5mW","paramValueEn":"62.5mW","paramValueEnForSearch":0.0625,"isMain":true,"sortNumber":1,"sort":20},{"paramCode":"param_11204_n","paramName":"最大工作电压","paramNameEn":"Voltage Rating","paramValue":"50V","paramValueEn":"50V","paramValueEnForSearch":50.0,"isMain":true,"sortNumber":1,"sort":18},{"paramCode":"param_11202","paramName":"电阻类型","paramNameEn":"Type","paramValue":"厚膜电阻","paramValueEn":"Thick Film Resistor","paramValueEnForSearch":-1.0,"isMain":true,"sortNumber":1,"sort":1},{"paramCode":"param_11185_s","paramName":"温度系数","paramNameEn":"Temperature Coefficient","paramValue":"±100ppm/℃","paramValueEn":"±100ppm/℃","paramValueEnForSearch":null,"isMain":true,"sortNumber":1,"sort":25},{"paramCode":"param_11206_s","paramName":"精度","paramNameEn":"Tolerance","paramValue":"±1%","paramValueEn":"±1%","paramValueEnForSearch":null,"isMain":true,"sortNumber":1,"sort":13},{"paramCode":"param_11156_s